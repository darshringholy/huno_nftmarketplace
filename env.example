# Environment Configuration
NODE_ENV=development

# RPC URLs
# Testnet (Development)
NEXT_PUBLIC_RPC_URL=https://rpc-plume-testnet-1.t.conduit.xyz/PdaZCGuTnwRXQRt5ZEt4Xxqdryx3Srnfe
NEXT_PUBLIC_EXPLORER_URL=https://testnet-explorer.plume.org

# Mainnet (Production) - Uncomment and update for production
# NEXT_PUBLIC_RPC_URL=https://rpc-plume-mainnet-1.t.conduit.xyz/PdaZCGuTnwRXQRt5ZEt4Xxqdryx3Srnfe
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.plume.org

# WalletConnect Project ID
# Get your project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=YOUR_PROJECT_ID

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/hunosmarket

# Optional: Analytics and Monitoring
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=

# File Upload Configuration
# Option 1: AWS S3 (recommended for production)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_S3_BUCKET=your_bucket_name

# Option 2: IPFS via Pinata (fallback)
# Get your API keys from https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_api_key 